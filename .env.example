HTTP_PORT=8082

# local default below; dev/production use an in-cluster broker (amqps://user:pass@host/vhost for CloudAMQP)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
JOB_QUEUE=job_status_email_notification
MONGO_URI=mongodb://localhost:27017
MONGO_DB=proteng_local

# base64-encoded RSA private key
ACCESS_TOKEN_PRIVATE_KEY=
ACCESS_TOKEN_EXPIRED_IN=1h
ACCESS_TOKEN_MAXAGE=3600

EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
ORIGIN=http://localhost:5173